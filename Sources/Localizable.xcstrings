    "Your feedback goes straight to the developer and helps shape what gets fixed next." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل ملاحظاتك مباشرة إلى المطور وتساعد في تحديد ما سيتم تحسينه لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Feedback geht direkt an den Entwickler und hilft mitzuentscheiden, was als Nächstes verbessert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus comentarios llegan directamente al desarrollador y ayudan a decidir qué se mejorará después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos commentaires sont envoyés directement au développeur et aident à définir les prochaines améliorations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी प्रतिक्रिया सीधे डेवलपर तक पहुँचती है और यह तय करने में मदद करती है कि आगे क्या सुधारा जाए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo feedback arriva direttamente allo sviluppatore e aiuta a decidere cosa migliorare in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックは開発者に直接届き、次に改善する内容の参考になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피드백은 개발자에게 직접 전달되며 다음 개선 사항을 결정하는 데 도움이 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
