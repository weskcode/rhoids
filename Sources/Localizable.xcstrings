        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머가 진행되는 동안 몇 가지 앱을 사용할 수 있어요. 시간이 다 되면 쿨다운과 함께 잠글게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
