    "Not done yet? No stress. Walk away and try again later." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تنتهِ بعد؟ لا توتر. ابتعد وحاول لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht fertig? Kein Stress. Geh und versuch’s später nochmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Aún no? Sin estrés. Aléjate e inténtalo luego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore fini ? Pas de stress. Éloignez-vous et réessayez plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी नहीं हुआ? कोई तनाव नहीं। चले जाएं और बाद में फिर कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora finito? Niente stress. Allontanati e riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ終わらない？気にしないで。一度離れて、後でまた。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 안 됐나요? 스트레스 받지 마세요. 자리를 뜨고 나중에 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não? Sem estresse. Saia e tente de novo depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ещё не всё? Без стресса. Отойдите и попробуйте позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha bitmedi mi? Stres yok. Uzaklaş ve sonra tekrar dene."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没好?别有压力。先离开,待会儿再试。"
          }
        }
      }
    },
