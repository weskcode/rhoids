    "We only notify when your timer ends. Nothing else." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُنبّهك فقط عند انتهاء المؤقت. لا شيء آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir benachrichtigen dich nur, wenn dein Timer endet. Sonst nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo te avisamos cuando termina el temporizador. Nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On vous notifie seulement à la fin de la minuterie. Rien d’autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम केवल तभी सूचित करते हैं जब आपका टाइमर खत्म हो। और कुछ नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisiamo solo quando il timer finisce. Nient’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマー終了時のみ通知します。それ以外は一切ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머가 끝날 때만 알립니다. 그 외에는 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só avisamos quando seu timer termina. Nada mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы уведомляем только об окончании таймера. Больше ничего."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca zamanlayıcınız bittiğinde bildirim göndeririz. Başka bir şey değil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们只在计时结束时通知你,仅此而已。"
          }
        }
      }
    },
    "We'll remind you to put your phone down when the timer starts. No Screen Time access needed." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنذكّرك بوضع هاتفك جانبًا عند بدء المؤقت. لا حاجة إلى إذن وقت الشاشة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erinnern dich daran, dein Handy wegzulegen, sobald der Timer startet. Kein Bildschirmzeit-Zugriff nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te recordaremos que sueltes el teléfono cuando empiece el temporizador. No se necesita acceso a Tiempo de uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vous rappellerons de poser votre téléphone au démarrage de la minuterie. Aucun accès à Temps d’écran requis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टाइमर शुरू होने पर हम आपको फ़ोन रखने की याद दिलाएंगे। स्क्रीन टाइम एक्सेस की ज़रूरत नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti ricorderemo di posare il telefono quando il timer si avvia. Non serve l’accesso a Tempo di utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーが始まると、スマホを置くようお知らせします。スクリーンタイムへのアクセスは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머가 시작되면 휴대폰을 내려놓으라고 알려드립니다. 스크린 타임 접근 권한이 필요 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos lembrar você de largar o celular quando o timer começar. Não é necessário acesso ao Tempo de Uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы напомним вам отложить телефон, когда таймер запустится. Доступ к «Экранному времени» не требуется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlayıcı başladığında telefonunuzu bırakmanız için size hatırlatacağız. Ekran Süresi erişimi gerekmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
