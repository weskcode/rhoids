    "Without notifications, alarms won't sound and warnings won't fire when the app is in the background." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون الإشعارات، لن تصدر التنبيهات ولن تُطلق التحذيرات عندما يكون التطبيق في الخلفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Mitteilungen ertönen keine Alarme und es werden keine Warnungen ausgelöst, wenn die App im Hintergrund ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin notificaciones, las alarmas no sonarán ni se activarán los avisos cuando la app esté en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans notifications, les alarmes ne sonneront pas et les avertissements ne se déclencheront pas lorsque l’app est en arrière-plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोटिफिकेशन के बिना, जब ऐप बैकग्राउंड में होगा तो अलार्म नहीं बजेंगे और चेतावनियां नहीं चलेंगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza notifiche, le sveglie non suoneranno e gli avvisi non scatteranno quando l’app è in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知がないと、Appがバックグラウンドのときにアラームは鳴らず、警告も発生しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림이 없으면 앱이 백그라운드에 있을 때 알람이 울리지 않고 경고도 작동하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem notificações, os alarmes não tocam e os avisos não disparam quando o app está em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без уведомлений будильники не прозвучат и предупреждения не сработают, когда приложение в фоне."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimler olmadan, uygulama arka plandayken alarmlar çalmaz ve uyarılar tetiklenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有通知,当应用处于后台时,闹钟不会响起,提醒也不会触发。"
          }
        }
      }
    },
