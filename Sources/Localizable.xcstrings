    "Gentle reminder: pushing = hemorrhoids. Don't do it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكير لطيف: الدفع = بواسير. لا تفعل ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanfte Erinnerung: Pressen = Hämorrhoiden. Lass es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordatorio amable: empujar = hemorroides. No lo hagas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petit rappel : pousser = hémorroïdes. Ne le faites pas."
