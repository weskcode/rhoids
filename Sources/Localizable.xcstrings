    "Block distracting apps when your RHOIDS timer finishes. Requires Screen Time authorization." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احجب التطبيقات المشتتة عند انتهاء مؤقت RHOIDS. يتطلب إذن وقت الشاشة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockiere ablenkende Apps, wenn dein RHOIDS-Timer endet. Erfordert die Bildschirmzeit-Berechtigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea las apps que distraen cuando termine tu temporizador de RHOIDS. Requiere autorización de Tiempo de uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquez les apps distrayantes à la fin de votre minuterie RHOIDS. Nécessite l’autorisation Temps d’écran."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आपका RHOIDS टाइमर खत्म हो तो ध्यान भटकाने वाले ऐप्स को ब्लॉक करें। स्क्रीन टाइम की अनुमति आवश्यक है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca le app che distraggono quando il timer RHOIDS finisce. Richiede l’autorizzazione a Tempo di utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHOIDSのタイマー終了時に気を散らすAppをブロックします。スクリーンタイムの許可が必要です。"
