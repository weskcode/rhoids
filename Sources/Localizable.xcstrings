          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользуйтесь несколькими приложениями во время таймера. Мы заблокируем их на время блокировки, когда время выйдет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlayıcınız sırasında birkaç uygulama kullanın. Süre dolduğunda bunları bir bekleme süresiyle kilitleyeceğiz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计时期间可以使用一些应用。时间一到,我们会用冷却时间将它们锁定。"
