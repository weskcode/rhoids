    "No rushing. If it's not happening, that's okay." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتعجّل. إن لم يحدث، فلا بأس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Eile. Wenn’s nicht klappt, ist das okay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin prisa. Si no sale, no pasa nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de précipitation. Si ça ne vient pas, ce n’est pas grave."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई जल्दबाज़ी नहीं। अगर नहीं हो रहा, तो ठीक है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente fretta. Se non succede, va bene così."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "焦らないで。出なくても大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서두르지 마세요. 안 되면 괜찮아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem pressa. Se não vier, tudo bem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не спешите. Не получается. и ладно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acele yok. Olmuyorsa, sorun değil."
