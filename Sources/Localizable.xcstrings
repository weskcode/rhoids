    "A single daily reminder to open RHOIDS and keep your usage streak going." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكير يومي واحد لفتح RHOIDS والحفاظ على استمرار سلسلة استخدامك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einzelne tägliche Erinnerung, RHOIDS zu öffnen und deine Nutzungsserie fortzusetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un único recordatorio diario para abrir RHOIDS y mantener tu racha de uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul rappel quotidien pour ouvrir RHOIDS et maintenir votre série d’utilisation."
