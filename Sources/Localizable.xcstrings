    "Notifications are turned off for RHOIDS. Enable them in Settings to hear the alarm." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشعارات معطّلة لـ RHOIDS. فعّلها من الإعدادات لسماع المنبّه."
