        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHOIDS 타이머가 끝나면 방해되는 앱을 차단합니다. 스크린 타임 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
