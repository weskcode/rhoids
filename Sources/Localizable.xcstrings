        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHOIDS खोलने और अपनी उपयोग स्ट्रीक जारी रखने के लिए एक दैनिक रिमाइंडर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un unico promemoria giornaliero per aprire RHOIDS e mantenere viva la tua serie di utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHOIDSを開いて連続利用記録を継続するための、1日1回のリマインダーです。"
