    "Changes take effect immediately, even for a timer that's already running." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبَّق التغييرات فورًا، حتى لو كان هناك مؤقت قيد التشغيل بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen wirken sich sofort aus, auch wenn bereits ein Timer läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios se aplican de inmediato, incluso si ya hay un temporizador en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications prennent effet immédiatement, même si une minuterie est déjà en cours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलाव तुरंत लागू होते हैं, भले ही कोई टाइमर पहले से चल रहा हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche hanno effetto immediato, anche se è già in corso un timer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーが実行中でも、変更はすぐに反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머가 이미 실행 중이어도 변경 사항은 즉시 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações têm efeito imediato, mesmo com um timer já em andamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения вступают в силу немедленно, даже если таймер уже запущен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
