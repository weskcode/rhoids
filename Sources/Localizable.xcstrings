    "Stand up and walk away. Not done? That's fine. Come back later." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انهض وابتعد. لم تنتهِ؟ لا بأس. عُد لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steh auf und geh. Noch nicht fertig? Kein Problem. komm später wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levántate y aléjate. ¿No terminaste? No pasa nada, vuelve luego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levez-vous et éloignez-vous. Pas fini ? Pas grave. revenez plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उठें और चले जाएं। नहीं हुआ? कोई बात नहीं. बाद में आएं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alzati e allontanati. Non hai finito? Va bene. torna più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立ち上がって離れましょう。終わらなかった？大丈夫、また後で。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일어나서 자리를 뜨세요. 안 끝났나요? 괜찮아요. 나중에 다시 오세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levante-se e saia. Não terminou? Tudo bem. volte depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте и отойдите. Не получилось? Ничего. вернётесь позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalk ve uzaklaş. Bitmedi mi? Sorun değil. sonra tekrar gel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起身离开吧。还没好?没关系。待会儿再来。"
          }
        }
      }
    },
    "Stand up. Walk away. Your body thanks you." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف. ابتعد. جسمك يشكرك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steh auf. Geh weg. Dein Körper dankt dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levántate. Aléjate. Tu cuerpo te lo agradece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levez-vous. Votre corps vous remercie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खड़े हो जाइए। शरीर शुक्रगुज़ार है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alzati. Il corpo ti ringrazia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立って。離れて。体が感謝するよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일어나세요. 몸이 감사할 거예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levante-se. Seu corpo agradece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встань. Уходи. Тело скажет спасибо."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalk. Uzaklaş. Vücudun teşekkür ediyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站起来。走开。身体会感谢你。"
          }
        }
      }
    },
