    },
    "Gentle reminders every 30 seconds to stay relaxed and not rush." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكيرات لطيفة كل 30 ثانية لتبقى مسترخيًا ولا تتعجّل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanfte Erinnerungen alle 30 Sekunden, um entspannt zu bleiben und dich nicht zu hetzen."
          }
        },
        "es" : {
