          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やさしい注意：いきむ＝痔。やめましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 알림: 힘주기 = 치질. 하지 마세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
