    "Used by the Home Screen widget and Siri shortcut when you start a timer without picking one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم بواسطة أداة الشاشة الرئيسية واختصار Siri عند بدء مؤقت دون اختيار واحد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird vom Home-Bildschirm-Widget und dem Siri-Kurzbefehl verwendet, wenn du einen Timer startest, ohne einen auszuwählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo usan el widget de la pantalla de inicio y el atajo de Siri cuando inicias un temporizador sin elegir uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé par le widget de l’écran d’accueil et le raccourci Siri lorsque vous lancez une minuterie sans en choisir une."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप बिना किसी को चुने टाइमर शुरू करते हैं, तो होम स्क्रीन विजेट और Siri शॉर्टकट द्वारा उपयोग किया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato dal widget della schermata Home e dal comando rapido di Siri quando avvii un timer senza sceglierne uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーを選ばずに開始したときに、ホーム画面ウィジェットとSiriショートカットが使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머를 고르지 않고 시작할 때 홈 화면 위젯과 Siri 단축어가 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado pelo widget da Tela de Início e pelo atalho da Siri quando você inicia um timer sem escolher um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется виджетом на экране «Домой» и командой Siri, когда вы запускаете таймер, не выбирая его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir zamanlayıcı seçmeden başlattığınızda Ana Ekran widget’ı ve Siri kısayolu tarafından kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你未选择计时器就启动时,主屏幕小组件和 Siri 快捷指令会使用它。"
          }
        }
      }
    },
