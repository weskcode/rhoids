    "Your timer is finished. These apps will unlock automatically when your cooldown ends." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهى مؤقتك. سيتم إلغاء قفل هذه التطبيقات تلقائيًا عند انتهاء فترة الانتظار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Timer ist abgelaufen. Diese Apps werden automatisch entsperrt, sobald deine Abklingzeit endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu temporizador ha terminado. Estas apps se desbloquearán automáticamente cuando termine el enfriamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre minuterie est terminée. Ces applications se déverrouilleront automatiquement à la fin de votre temps de repos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका टाइमर खत्म हो गया है। कूलडाउन समाप्त होने पर ये ऐप्स अपने आप अनलॉक हो जाएंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il timer è terminato. Queste app si sbloccheranno automaticamente al termine del raffreddamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーが終了しました。クールダウンが終わると、これらのアプリは自動的にロック解除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머가 종료되었습니다. 쿨다운이 끝나면 이 앱들은 자동으로 잠금 해제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu timer terminou. Esses apps serão desbloqueados automaticamente quando seu tempo de espera acabar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш таймер завершён. Эти приложения разблокируются автоматически по окончании времени блокировки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlayıcınız sona erdi. Bekleme süreniz bittiğinde bu uygulamaların kilidi otomatik olarak açılacak."
          }
        },
        "zh-Hans" : {
