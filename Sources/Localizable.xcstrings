    "Breathe. Straining causes the exact thing we're preventing." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنفّس. الإجهاد يسبب تمامًا ما نحاول منعه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme. Pressen verursacht genau das, was wir verhindern wollen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira. Hacer fuerza provoca justo lo que queremos evitar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirez. Forcer provoque exactement ce qu’on veut éviter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सांस लें। ज़ोर लगाना ठीक वही करता है जिसे हम रोक रहे हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira. Sforzarsi causa proprio ciò che vogliamo evitare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深呼吸を。いきむと、防ぎたいことが起きてしまいます。"
