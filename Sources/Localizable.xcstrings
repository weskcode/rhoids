    "Take it easy. Your body works on its own schedule." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمهّل. جسدك يعمل وفق إيقاعه الخاص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dir Zeit. Dein Körper hat seinen eigenen Rhythmus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tómatelo con calma. Tu cuerpo tiene su propio ritmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allez-y doucement. Votre corps suit son propre rythme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आराम से लें। आपका शरीर अपने समय पर काम करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacci piano. Il tuo corpo ha i suoi tempi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "のんびりいきましょう。体には体のペースがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "천천히 하세요. 몸은 자기 속도로 움직입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá com calma. Seu corpo tem o próprio ritmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не торопитесь. У тела свой график."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acele etme. Vücudun kendi temposunda çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放轻松。身体有它自己的节奏。"
          }
        }
      }
    },
