    "30 seconds left. Don't rush. Just start wrapping up." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بقيت 30 ثانية. لا تتعجّل. ابدأ بالإنهاء فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch 30 Sekunden. Nicht hetzen. komm einfach zum Schluss."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedan 30 segundos. Sin prisa: ve terminando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus que 30 secondes. Pas de précipitation. commencez à conclure."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 सेकंड बचे हैं। जल्दबाज़ी न करें. बस समेटना शुरू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restano 30 secondi. Niente fretta. inizia a concludere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残り30秒。焦らず、そろそろ切り上げを。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30초 남았어요. 서두르지 말고 마무리를 시작하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltam 30 segundos. Sem pressa. vá finalizando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осталось 30 секунд. Не спешите. просто начинайте завершать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 saniye kaldı. Acele etme. yavaşça toparlanmaya başla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还剩 30 秒。别急。慢慢收尾即可。"
          }
        }
      }
    },
    "30 seconds left. It's okay to walk away unfinished." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بقيت 30 ثانية. لا بأس أن تنصرف دون أن تنتهي."
          }
        },
        "de" : {
          "stringUnit" : {
