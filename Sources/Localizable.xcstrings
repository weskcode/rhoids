        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокируйте отвлекающие приложения по окончании таймера RHOIDS. Требуется доступ к «Экранному времени»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RHOIDS zamanlayıcınız bittiğinde dikkat dağıtan uygulamaları engelleyin. Ekran Süresi izni gerekir."
